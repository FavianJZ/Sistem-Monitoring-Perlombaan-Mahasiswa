# Salin berkas ini menjadi .env.local untuk menjalankan aplikasi dengan Supabase di komputer sendiri.
# Di Vercel, isi nilai yang sama di Project Settings -> Environment Variables.

# Project Settings -> Data API (Project URL)
VITE_SUPABASE_URL=

# Project Settings -> API Keys -> Legacy API keys -> anon public
VITE_SUPABASE_ANON_KEY=

# Opsional: email kontak yang tampil di halaman /privasi
VITE_EMAIL_KONTAK=

# Hanya untuk situs demo berisi data contoh. Jangan diisi di situs produksi.
# VITE_MODE_DEMO=true
